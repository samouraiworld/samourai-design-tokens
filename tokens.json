{
  "$schema": "https://tr.designtokens.org/format/",
  "color": {
    "$type": "color",
    "slate": {
      "100": {
        "$value": "#EEF2F6"
      },
      "150": {
        "$value": "#E4EAF1"
      },
      "200": {
        "$value": "#D9E1EA"
      },
      "300": {
        "$value": "#C9D3DE"
      },
      "500": {
        "$value": "#7C8894"
      },
      "600": {
        "$value": "#66737F"
      },
      "700": {
        "$value": "#56626E"
      },
      "900": {
        "$value": "#2F3A45"
      }
    },
    "frost": {
      "100": {
        "$value": "#EEF3F8"
      },
      "200": {
        "$value": "#DCE6F0"
      }
    },
    "white": {
      "$value": "#FFFFFF"
    },
    "black": {
      "$value": "#000000"
    },
    "cobalt": {
      "100": {
        "$value": "#E4E9FB"
      },
      "500": {
        "$value": "#2B4BDB"
      },
      "600": {
        "$value": "#2340C4"
      }
    },
    "green": {
      "100": {
        "$value": "#E3F3EA"
      },
      "500": {
        "$value": "#2E8B57"
      },
      "600": {
        "$value": "#1F7A45"
      }
    },
    "amber": {
      "100": {
        "$value": "#FBF1DC"
      },
      "500": {
        "$value": "#B7791F"
      },
      "600": {
        "$value": "#8A5A10"
      }
    },
    "red": {
      "100": {
        "$value": "#FBE5E2"
      },
      "500": {
        "$value": "#C2372B"
      },
      "600": {
        "$value": "#B5321F"
      }
    }
  },
  "semantic": {
    "$type": "color",
    "surface": {
      "page": {
        "$value": "{color.frost.100}",
        "$description": "Flat fallback; the page background is the frost gradient 115deg frost.200 → frost.100 (45%) → white"
      },
      "default": {
        "$value": "{color.white}"
      },
      "muted": {
        "$value": "{color.slate.100}"
      },
      "accent": {
        "$value": "{color.cobalt.100}"
      },
      "inverse": {
        "$value": "{color.slate.900}"
      }
    },
    "border": {
      "default": {
        "$value": "{color.slate.200}"
      },
      "soft": {
        "$value": "{color.slate.150}"
      },
      "hairline": {
        "$value": "{color.slate.100}"
      },
      "input": {
        "$value": "{color.slate.300}"
      }
    },
    "text": {
      "primary": {
        "$value": "{color.slate.900}"
      },
      "secondary": {
        "$value": "{color.slate.700}"
      },
      "tertiary": {
        "$value": "{color.slate.600}",
        "$description": "5.0:1 on white — smallest body colour"
      },
      "placeholder": {
        "$value": "{color.slate.500}",
        "$description": "Never real text (3.9:1)"
      },
      "inverse": {
        "$value": "{color.white}"
      },
      "accent": {
        "$value": "{color.cobalt.500}"
      },
      "success": {
        "$value": "{color.green.600}"
      },
      "warning": {
        "$value": "{color.amber.600}"
      },
      "danger": {
        "$value": "{color.red.600}"
      }
    },
    "action": {
      "primary": {
        "$value": "{color.cobalt.500}"
      },
      "primaryHover": {
        "$value": "{color.cobalt.600}"
      },
      "onPrimary": {
        "$value": "{color.white}"
      },
      "danger": {
        "$value": "{color.red.500}"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Plus Jakarta Sans",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "IBM Plex Mono",
          "ui-monospace",
          "SF Mono",
          "Menlo",
          "monospace"
        ]
      }
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": "12px"
      },
      "sm": {
        "$value": "13px"
      },
      "md": {
        "$value": "14px"
      },
      "lg": {
        "$value": "16px"
      },
      "xl": {
        "$value": "20px"
      },
      "2xl": {
        "$value": "24px"
      },
      "3xl": {
        "$value": "30px"
      },
      "4xl": {
        "$value": "40px"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "tracking": {
      "$type": "dimension",
      "tight": {
        "$value": "-0.045em"
      },
      "snug": {
        "$value": "-0.02em"
      }
    },
    "lineHeight": {
      "$type": "number",
      "tight": {
        "$value": 1.1
      },
      "snug": {
        "$value": 1.25
      },
      "body": {
        "$value": 1.55
      }
    }
  },
  "space": {
    "1": {
      "$value": "4px"
    },
    "2": {
      "$value": "8px"
    },
    "3": {
      "$value": "12px"
    },
    "4": {
      "$value": "16px"
    },
    "5": {
      "$value": "20px"
    },
    "6": {
      "$value": "24px"
    },
    "8": {
      "$value": "32px"
    },
    "10": {
      "$value": "40px"
    },
    "12": {
      "$value": "48px"
    },
    "$type": "dimension"
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "6px",
      "$description": "inputs"
    },
    "md": {
      "$value": "8px",
      "$description": "buttons"
    },
    "lg": {
      "$value": "12px",
      "$description": "cards"
    },
    "xl": {
      "$value": "16px",
      "$description": "panels"
    },
    "full": {
      "$value": "999px"
    }
  },
  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": {
        "color": "rgba(47,58,69,0.25)",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "-16px"
      }
    },
    "pop": {
      "$value": {
        "color": "rgba(47,58,69,0.35)",
        "offsetX": "0px",
        "offsetY": "20px",
        "blur": "50px",
        "spread": "-20px"
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "120ms"
      },
      "base": {
        "$value": "200ms"
      },
      "slow": {
        "$value": "320ms"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "out": {
        "$value": [
          0.2,
          0.7,
          0.3,
          1
        ]
      }
    }
  }
}